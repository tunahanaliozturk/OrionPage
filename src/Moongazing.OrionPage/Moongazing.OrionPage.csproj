<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>OrionPage</PackageId>
    <Description>Keyset (cursor) pagination for .NET that stays fast on page 10,000, because OFFSET is a table scan. This framework-free core carries Page&lt;T&gt;, the opaque cursor codec, InvalidCursorException, PageOptions and telemetry — all reflection-free and AOT-clean. Add OrionPage.EntityFrameworkCore for the ToKeysetPageAsync query extension.</Description>
    <PackageTags>orion;pagination;keyset;cursor;paging;ef-core;dotnet</PackageTags>
    <RootNamespace>Moongazing.OrionPage</RootNamespace>
    <PackageReadmeFile>docs/README.md</PackageReadmeFile>
    <Product>OrionPage</Product>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Orion.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Moongazing.OrionPage.Tests" />
    <InternalsVisibleTo Include="Moongazing.OrionPage.EntityFrameworkCore" />
    <InternalsVisibleTo Include="Moongazing.OrionPage.EntityFrameworkCore.Tests" />
  </ItemGroup>
  <ItemGroup>
    <None Include="docs/README.md" Pack="true" PackagePath="docs/" />
  </ItemGroup>
</Project>
